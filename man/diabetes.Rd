\name{diabetes}
\alias{diabetes}
\docType{data}
\title{Pima Indians Diabetes Data}
\description{
A public dataset for binary classification in which the outcome records a
diabetes diagnosis and the predictors contain diagnostic measurements.
}
\usage{data(diabetes)}
\format{
A data frame with 768 observations and 9 variables:
\describe{
  \item{Pregnancies}{Number of pregnancies.}
  \item{Glucose}{Plasma glucose concentration.}
  \item{BloodPressure}{Diastolic blood pressure.}
  \item{SkinThickness}{Triceps skin-fold thickness.}
  \item{Insulin}{Two-hour serum insulin.}
  \item{BMI}{Body mass index.}
  \item{DiabetesPedigreeFunction}{Diabetes pedigree function.}
  \item{Age}{Age in years.}
  \item{Outcome}{Binary diabetes indicator.}
}
}
\source{
The public Pima Indians Diabetes Database, originally provided by the
National Institute of Diabetes and Digestive and Kidney Diseases.
}
\keyword{datasets}
